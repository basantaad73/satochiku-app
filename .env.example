# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=YOUR_PROJECT_REF.supabase.co

# SERVER ONLY. Never expose this to the browser or commit it.
# Bypasses Row Level Security — used only inside app/admin/actions.ts
# and other server-only files after an explicit admin check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute redirect URLs (password reset emails, invites)
NEXT_PUBLIC_SITE_URL=https://app.your-domain.example

# Only needed for `npm run db:types`
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
